<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="900dp"
            >

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/missing"
                android:src="@drawable/helenka"
                android:id="@+id/helenka"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:text="@string/missing"
                android:background="@color/greenish"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:textSize="40sp"/>
        </FrameLayout>

        <Button
            android:layout_width="300dp"
            android:layout_height="130dp"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/greenish"
            android:text="@string/yesofc"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:id="@+id/yes"/>
        <Button
            android:layout_width="170dp"
            android:layout_height="130dp"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@id/yes"
            android:backgroundTint="@color/greenish"
            android:text="@string/no"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:id="@+id/no"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>